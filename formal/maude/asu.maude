*** ASU full protocol (SPEC section 4), bounded model. Mirrors formal/tamarin/asu.spthy.
load common.maude

mod ASU-MODEL is
  including ASU-ADV .
  vars U A G N E E2 C S HD : Msg . vars K ES CS : MsgSet .
  vars F B Q : Nat . var L : Log .

  *** Steps 3-6: the agent submits ANY effect; gateway stores pending approval
  *** id, nonce and descriptor, and returns the id. Conservatively the nonce is
  *** also leaked to the agent.
  crl [call] : fresh(F, B) effs(E ; ES) ik(K) gw(U)
   => fresh(s F, B) effs(E ; ES) ik(K ; aid(F) ; nc(F)) gw(U)
      pending(U, aid(F), nc(F), E) todev(U, aid(F), nc(F), E)
   if F < B .

  *** Step 7: the device shows the card rendered from E (authentic channel);
  *** the human approves what is shown; the passkey signs
  *** c = (tag, h(E), A, N). The assertion is sent on a public channel.
  rl [approve] : todev(U, A, N, E) dev(U) ik(K) log(L)
   => dev(U) ik(K ; sig(tup(tagA, h(E), A, N), sk(U)))
      log(L ;; approve(U, A, E) ;; signed(U, A, h(E))) .

  *** Gateway verifies an assertion received from anyone (including the agent).
  crl [verify] : pending(U, A, N, E) ik(S ; K) log(L)
   => apst(U, A, N, E) ik(S ; K) log(L ;; approved(U, A, E))
   if S == sig(tup(tagA, h(E), A, N), sk(U)) .
  *** P5's offline judge is a state predicate (badL4sig in common.maude).
  *** Gateway corruption is a no-op here: the gateway stores only pk(U),
  *** which is already public, so it adds nothing to the agent's knowledge.

  *** Step 8: agent retries with A and (re)submitted args E2. Gateway checks
  *** h(E2) = h(E), consumes the approval (linear fact disappears) and executes
  *** its OWN stored E.
  crl [exec] : apst(U, A, N, E) ik(K) effs(E2 ; ES) budget(s Q) log(L)
   => ik(K) effs(E2 ; ES) budget(Q) log(L ;; exec(U, A, E))
   if memb(A, K) and h(E2) == h(E) .

  *** Grants (step 7 "grant similar"): the constraint C is part of what is signed.
  crl [grant-req] : fresh(F, B) scopes(C ; CS) ik(K) gw(U)
   => fresh(s F, B) scopes(C ; CS) ik(K ; aid(F) ; nc(F)) gw(U)
      pgrant(U, aid(F), nc(F), C) todevg(U, aid(F), nc(F), C)
   if F < B .
  rl [approve-grant] : todevg(U, G, N, C) dev(U) ik(K) log(L)
   => dev(U) ik(K ; sig(tup(tagG, h(C), G, N), sk(U))) log(L ;; approvegrant(U, G, C)) .
  crl [verify-grant] : pgrant(U, G, N, C) ik(S ; K)
   => gst(U, G, C, 2) ik(S ; K)
   if S == sig(tup(tagG, h(C), G, N), sk(U)) .
  *** Execute under grant: only effects inside the signed constraint, max 2 uses.
  crl [exec-grant] : gst(U, G, C, s Q) ik(K) effs(E ; ES) log(L)
   => gst(U, G, C, Q) ik(K) effs(E ; ES) log(L ;; execg(U, G, C, E))
   if memb(G, K) and scope(E) == C .

  *** init(B, X, SC): at most B fresh approvals/grants, at most X executions,
  *** grant-constraint universe SC (mt = grants disabled).
  op init : Nat Nat MsgSet -> Config .
  var SC : MsgSet .
  vars BB XX : Nat .
  eq init(BB, XX, SC) = fresh(0, BB) budget(XX)
            effs(eff(c1, x1) ; eff(c1, x2) ; eff(c2, x1)) scopes(SC)
            ik(u ; pk(u) ; tagA ; tagG) dev(u) gw(u) log(nil) .
endm

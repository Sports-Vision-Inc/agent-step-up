*** V5 "symmetric MAC": as ASU, but the device authenticates the approval with a
*** MAC under key(U) shared with the gateway instead of a passkey signature.
*** The gateway is NOT trusted for non-repudiation: it may be corrupted and
*** leak/misuse key(U). Mirrors v5_mac.spthy. Expected: L4 FALSIFIED.
load common.maude

mod V5-MODEL is
  including ASU-ADV .
  vars U A N E E2 S : Msg . vars K ES : MsgSet .
  vars F B Q BB XX : Nat . var L : Log .

  crl [call] : fresh(F, B) effs(E ; ES) ik(K) gw(U)
   => fresh(s F, B) effs(E ; ES) ik(K ; aid(F) ; nc(F)) gw(U)
      pending(U, aid(F), nc(F), E) todev(U, aid(F), nc(F), E)
   if F < B .
  rl [approve] : todev(U, A, N, E) dev(U) ik(K) log(L)
   => dev(U) ik(K ; mac(tup(tagA, h(E), A, N), key(U)))
      log(L ;; approve(U, A, E) ;; signed(U, A, h(E))) .
  crl [verify] : pending(U, A, N, E) ik(S ; K) log(L)
   => apst(U, A, N, E) ik(S ; K) log(L ;; approved(U, A, E))
   if S == mac(tup(tagA, h(E), A, N), key(U)) .
  crl [exec] : apst(U, A, N, E) ik(K) effs(E2 ; ES) budget(s Q) log(L)
   => ik(K) effs(E2 ; ES) budget(Q) log(L ;; exec(U, A, E))
   if memb(A, K) and h(E2) == h(E) .
  *** The gateway holds key(U); a corrupt (or dishonest) gateway can mint MACs.
  crl [gw-corrupt] : gw(U) ik(K) log(L)
   => gw(U) ik(K ; key(U)) log(L ;; gwcorrupt(U))
   if not occ(gwcorrupt(U), L) .

  op init : Nat Nat MsgSet -> Config .
  var SC : MsgSet .
  eq init(BB, XX, SC) = fresh(0, BB) budget(XX)
            effs(eff(c1, x1) ; eff(c1, x2) ; eff(c2, x1)) scopes(SC)
            ik(u ; pk(u) ; tagA) dev(u) gw(u) log(nil) .
endm

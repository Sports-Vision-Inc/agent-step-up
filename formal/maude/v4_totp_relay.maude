*** V4a "totp": out-of-band card, but the approval factor is a TOTP code the
*** human types into the agent's chat (the agent relays it to the gateway).
*** The code depends only on (key(U), time window), not on A or E.
*** Mirrors v4_totp_relay.spthy. Expected: L3 and L1 FALSIFIED.
load common.maude

mod V4-MODEL is
  including ASU-ADV .
  vars U A N E E2 S : Msg . vars K ES : MsgSet .
  vars F B Q BB XX : Nat . var L : Log .

  crl [call] : fresh(F, B) effs(E ; ES) ik(K) gw(U)
   => fresh(s F, B) effs(E ; ES) ik(K ; aid(F) ; nc(F)) gw(U)
      pending(U, aid(F), nc(F), E) todev(U, aid(F), nc(F), E)
   if F < B .
  *** Human sees the (trusted) card for E, approves, and types the current code
  *** into the agent channel: the agent learns it.
  rl [approve] : todev(U, A, N, E) dev(U) ik(K) log(L)
   => dev(U) ik(K ; totp(key(U), w0)) log(L ;; approve(U, A, E)) .
  *** Gateway accepts the current code for ANY pending approval of U.
  crl [verify] : pending(U, A, N, E) ik(S ; K) log(L)
   => apst(U, A, N, E) ik(S ; K) log(L ;; approved(U, A, E))
   if S == totp(key(U), w0) and memb(A, S ; K) .
  crl [exec] : apst(U, A, N, E) ik(K) effs(E2 ; ES) budget(s Q) log(L)
   => ik(K) effs(E2 ; ES) budget(Q) log(L ;; exec(U, A, E))
   if memb(A, K) and h(E2) == h(E) .

  op init : Nat Nat MsgSet -> Config .
  var SC : MsgSet .
  eq init(BB, XX, SC) = fresh(0, BB) budget(XX)
            effs(eff(c1, x1) ; eff(c1, x2) ; eff(c2, x1)) scopes(SC)
            ik(u ; pk(u) ; w0) dev(u) gw(u) log(nil) .
endm

*** V4b "chat-confirm": the agent asks "may I?" in its own channel and a "yes"
*** in that channel approves. The agent can write yes(A) itself.
*** Mirrors v4b_chat_confirm.spthy. Expected: L3 and L1 FALSIFIED.
load common.maude

mod V4B-MODEL is
  including ASU-ADV .
  vars U A N E E2 : Msg . vars K ES : MsgSet .
  vars F B Q BB XX : Nat . var L : Log .

  crl [call] : fresh(F, B) effs(E ; ES) ik(K) gw(U)
   => fresh(s F, B) effs(E ; ES) ik(K ; aid(F) ; nc(F)) gw(U)
      pending(U, aid(F), nc(F), E) todev(U, aid(F), nc(F), E)
   if F < B .
  *** A genuine human "yes" typed into the agent chat (the agent sees/relays it).
  rl [approve] : todev(U, A, N, E) dev(U) ik(K) log(L)
   => dev(U) ik(K ; yes(A)) log(L ;; approve(U, A, E)) .
  *** Gateway accepts yes(A) arriving on the agent channel. The agent can
  *** construct yes(A) from A, which it knows.
  crl [verify] : pending(U, A, N, E) ik(K) log(L)
   => apst(U, A, N, E) ik(K) log(L ;; approved(U, A, E))
   if memb(A, K) .
  crl [exec] : apst(U, A, N, E) ik(K) effs(E2 ; ES) budget(s Q) log(L)
   => ik(K) effs(E2 ; ES) budget(Q) log(L ;; exec(U, A, E))
   if memb(A, K) and h(E2) == h(E) .

  op init : Nat Nat MsgSet -> Config .
  var SC : MsgSet .
  eq init(BB, XX, SC) = fresh(0, BB) budget(XX)
            effs(eff(c1, x1) ; eff(c1, x2) ; eff(c2, x1)) scopes(SC)
            ik(u ; pk(u)) dev(u) gw(u) log(nil) .
endm

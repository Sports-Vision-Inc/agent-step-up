theory ASU_V4_TOTP_Relay begin

// Function signature and definition of the equational theory E

functions: fst/1, h/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2







restriction Equality:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

restriction FirstEnrollmentOnce:
  "∀ U #i #j. ((OnlyOnce( U ) @ #i) ∧ (OnlyOnce( U ) @ #j)) ⇒ (#i = #j)"
  // safety formula

restriction TotpStepOnce:
  "∀ U w #i #j.
    ((UseStep( U, w ) @ #i) ∧ (UseStep( U, w ) @ #j)) ⇒ (#i = #j)"
  // safety formula

rule (modulo E) Register_Device:
   [ Fr( ~k ) ]
  --[ OnlyOnce( $U ), Register( $U ) ]->
   [ !TotpKey( $U, ~k ), !Enrolled( $U ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Compromise_Device:
   [ !TotpKey( U, k ) ] --[ Compromise( U ) ]-> [ Out( k ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Gateway_ToolCall:
   [ In( <'call', U, e> ), !Enrolled( U ), Fr( ~aid ) ]
  --[ Challenge( U, ~aid, e ) ]->
   [ Pending( U, ~aid, e ), ToDevice( U, ~aid, e ), Out( ~aid ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Human_Approves_TypesCode:
   [ ToDevice( U, aid, e ), !TotpKey( U, k ), Fr( ~w ) ]
  --[ HumanApproves( U, aid, e ) ]->
   [ Out( <~w, h(<k, ~w>)> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Gateway_Verify:
   [ Pending( U, aid, e ), In( <'code', aid, w, code> ), !TotpKey( U, k ) ]
  --[ Eq( code, h(<k, w>) ), UseStep( U, w ), Approved( U, aid, e ) ]->
   [ ApprovedSt( U, aid, e ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Gateway_Execute:
   [ ApprovedSt( U, aid, e ), In( <'exec', aid, e2> ) ]
  --[ Execute( U, aid, e2 ) ]->
   [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Gateway_ToolCall_WithCode:
   [ In( <'call_totp', U, e, w, code> ), !TotpKey( U, k ), Fr( ~aid ) ]
  --[
  Eq( code, h(<k, w>) ), UseStep( U, w ), Approved( U, ~aid, e ),
  Execute( U, ~aid, e )
  ]->
   [ ]

  /* has exactly the trivial AC variant */

lemma exec_possible:
  exists-trace
  "∃ U aid e #i.
    (Execute( U, aid, e ) @ #i) ∧ (¬(∃ #k. Compromise( U ) @ #k))"
/*
guarded formula characterizing all satisfying traces:
"∃ U aid e #i.
  (Execute( U, aid, e ) @ #i) ∧ ∀ #k. (Compromise( U ) @ #k) ⇒ ⊥"
*/
by sorry

lemma L1_effect_binding:
  all-traces
  "∀ U aid e #i.
    (Execute( U, aid, e ) @ #i) ⇒
    ((∃ #j. (HumanApproves( U, aid, e ) @ #j) ∧ (#j < #i)) ∨
     (∃ #k. (Compromise( U ) @ #k) ∧ (#k < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ U aid e #i.
  (Execute( U, aid, e ) @ #i)
 ∧
  (∀ #j. (HumanApproves( U, aid, e ) @ #j) ⇒ ¬(#j < #i)) ∧
  (∀ #k. (Compromise( U ) @ #k) ⇒ ¬(#k < #i))"
*/
by sorry

lemma L2_single_use:
  all-traces
  "∀ U1 U2 aid e1 e2 #i #j.
    ((Execute( U1, aid, e1 ) @ #i) ∧ (Execute( U2, aid, e2 ) @ #j)) ⇒
    (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ U1 U2 aid e1 e2 #i #j.
  (Execute( U1, aid, e1 ) @ #i) ∧ (Execute( U2, aid, e2 ) @ #j)
 ∧
  ¬(#i = #j)"
*/
by sorry

lemma L3_agent_independence:
  all-traces
  "∀ U aid e #i.
    (Approved( U, aid, e ) @ #i) ⇒
    ((∃ #j. (HumanApproves( U, aid, e ) @ #j) ∧ (#j < #i)) ∨
     (∃ #k. (Compromise( U ) @ #k) ∧ (#k < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ U aid e #i.
  (Approved( U, aid, e ) @ #i)
 ∧
  (∀ #j. (HumanApproves( U, aid, e ) @ #j) ⇒ ¬(#j < #i)) ∧
  (∀ #k. (Compromise( U ) @ #k) ⇒ ¬(#k < #i))"
*/
simplify
solve( Approved( U, aid, e ) @ #i )
  case Gateway_ToolCall_WithCode
  solve( !TotpKey( U, k ) ▶₁ #i )
    case Register_Device
    solve( !KU( h(<~k, w>) ) @ #vk.8 )
      case Human_Approves_TypesCode
      solve( !KU( ~w ) @ #vk.9 )
        case Human_Approves_TypesCode
        SOLVED // trace found
      qed
    qed
  qed
qed










theory ASU_V5_MAC begin

// Function signature and definition of the equational theory E

functions: fst/1, h/1, mac/2, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2







restriction Equality:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

restriction FirstEnrollmentOnce:
  "∀ U #i #j. ((OnlyOnce( U ) @ #i) ∧ (OnlyOnce( U ) @ #j)) ⇒ (#i = #j)"
  // safety formula

rule (modulo E) Register_Device:
   [ Fr( ~k ) ] --[ OnlyOnce( $U ) ]-> [ !Ltk( $U, ~k ), !GwKey( $U, ~k ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Compromise_Device:
   [ !Ltk( U, sk ) ] --[ Compromise( U ) ]-> [ Out( sk ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Corrupt_Gateway:
   [ !GwKey( U, k ) ] --[ GatewayCorrupt( U ) ]-> [ Out( k ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Gateway_ToolCall:
   [ In( <'call', U, e> ), !GwKey( U, k ), Fr( ~aid ) ]
  --[ Challenge( U, ~aid, e ) ]->
   [ Pending( U, ~aid, e ), ToDevice( U, ~aid, e ), Out( ~aid ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Human_DecidesOnTrustedFields:
   [ ToDevice( U, aid, e ), !Ltk( U, sk ) ]
  --[ HumanApproves( U, aid, e ), Signed( U, aid, h(e) ) ]->
   [ Out( mac(<'ASU-APPROVAL-v2', h(e), aid, 'null'>, sk) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Gateway_Verify:
   [ Pending( U, aid, e ), In( s ), !GwKey( U, k ) ]
  --[
  Eq( s, mac(<'ASU-APPROVAL-v2', h(e), aid, 'null'>, k) ),
  Approved( U, aid, e )
  ]->
   [ ApprovedSt( U, aid, e, s ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Gateway_Execute:
   [ ApprovedSt( U, aid, e, s ), In( <'exec', aid, e2> ) ]
  --[ Eq( h(e2), h(e) ), Execute( U, aid, e ) ]->
   [ Out( <'receipt', U, aid, h(e), 'null', s> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Judge_Accept:
   [ In( <'receipt', U, aid, hd, gd, s> ), !GwKey( U, k ) ]
  --[
  Eq( s, mac(<'ASU-APPROVAL-v2', hd, aid, gd>, k) ),
  JudgeAccepts( U, aid, hd )
  ]->
   [ ]

  /* has exactly the trivial AC variant */

lemma exec_possible:
  exists-trace
  "∃ U aid e #i.
    (Execute( U, aid, e ) @ #i) ∧ (¬(∃ #k. Compromise( U ) @ #k))"
/*
guarded formula characterizing all satisfying traces:
"∃ U aid e #i.
  (Execute( U, aid, e ) @ #i) ∧ ∀ #k. (Compromise( U ) @ #k) ⇒ ⊥"
*/
simplify
solve( ApprovedSt( U, aid, e, s ) ▶₀ #i )
  case Gateway_Verify
  solve( !KU( mac(<'ASU-APPROVAL-v2', h(e), ~aid, 'null'>, ~k) ) @ #vk.6 )
    case Human_DecidesOnTrustedFields
    solve( !KU( ~aid ) @ #vk.4 )
      case Gateway_ToolCall
      SOLVED // trace found
    qed
  qed
qed

lemma judge_possible:
  exists-trace
  "∃ U aid hd #i.
    (JudgeAccepts( U, aid, hd ) @ #i) ∧ (¬(∃ #k. Compromise( U ) @ #k))"
/*
guarded formula characterizing all satisfying traces:
"∃ U aid hd #i.
  (JudgeAccepts( U, aid, hd ) @ #i) ∧ ∀ #k. (Compromise( U ) @ #k) ⇒ ⊥"
*/
by sorry

lemma L1_effect_binding:
  all-traces
  "∀ U aid e #i.
    (Execute( U, aid, e ) @ #i) ⇒
    (((∃ #j. (HumanApproves( U, aid, e ) @ #j) ∧ (#j < #i)) ∨
      (∃ #k. (Compromise( U ) @ #k) ∧ (#k < #i))) ∨
     (∃ #g. (GatewayCorrupt( U ) @ #g) ∧ (#g < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ U aid e #i.
  (Execute( U, aid, e ) @ #i)
 ∧
  (∀ #j. (HumanApproves( U, aid, e ) @ #j) ⇒ ¬(#j < #i)) ∧
  (∀ #k. (Compromise( U ) @ #k) ⇒ ¬(#k < #i)) ∧
  (∀ #g. (GatewayCorrupt( U ) @ #g) ⇒ ¬(#g < #i))"
*/
by sorry

lemma L1_sig_binding:
  all-traces
  "∀ U aid e #i.
    (Execute( U, aid, e ) @ #i) ⇒
    (((∃ #j. (Signed( U, aid, h(e) ) @ #j) ∧ (#j < #i)) ∨
      (∃ #k. (Compromise( U ) @ #k) ∧ (#k < #i))) ∨
     (∃ #g. (GatewayCorrupt( U ) @ #g) ∧ (#g < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ U aid e #i.
  (Execute( U, aid, e ) @ #i)
 ∧
  (∀ #j. (Signed( U, aid, h(e) ) @ #j) ⇒ ¬(#j < #i)) ∧
  (∀ #k. (Compromise( U ) @ #k) ⇒ ¬(#k < #i)) ∧
  (∀ #g. (GatewayCorrupt( U ) @ #g) ⇒ ¬(#g < #i))"
*/
by sorry

lemma L2_single_use:
  all-traces
  "∀ U1 U2 aid e1 e2 #i #j.
    ((Execute( U1, aid, e1 ) @ #i) ∧ (Execute( U2, aid, e2 ) @ #j)) ⇒
    (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ U1 U2 aid e1 e2 #i #j.
  (Execute( U1, aid, e1 ) @ #i) ∧ (Execute( U2, aid, e2 ) @ #j)
 ∧
  ¬(#i = #j)"
*/
by sorry

lemma L3_agent_independence:
  all-traces
  "∀ U aid e #i.
    (Approved( U, aid, e ) @ #i) ⇒
    (((∃ #j. (HumanApproves( U, aid, e ) @ #j) ∧ (#j < #i)) ∨
      (∃ #k. (Compromise( U ) @ #k) ∧ (#k < #i))) ∨
     (∃ #g. (GatewayCorrupt( U ) @ #g) ∧ (#g < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ U aid e #i.
  (Approved( U, aid, e ) @ #i)
 ∧
  (∀ #j. (HumanApproves( U, aid, e ) @ #j) ⇒ ¬(#j < #i)) ∧
  (∀ #k. (Compromise( U ) @ #k) ⇒ ¬(#k < #i)) ∧
  (∀ #g. (GatewayCorrupt( U ) @ #g) ⇒ ¬(#g < #i))"
*/
by sorry

lemma L4_non_repudiation:
  all-traces
  "∀ U aid hd #i.
    (JudgeAccepts( U, aid, hd ) @ #i) ⇒
    ((∃ #j. (Signed( U, aid, hd ) @ #j) ∧ (#j < #i)) ∨
     (∃ #k. (Compromise( U ) @ #k) ∧ (#k < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ U aid hd #i.
  (JudgeAccepts( U, aid, hd ) @ #i)
 ∧
  (∀ #j. (Signed( U, aid, hd ) @ #j) ⇒ ¬(#j < #i)) ∧
  (∀ #k. (Compromise( U ) @ #k) ⇒ ¬(#k < #i))"
*/
by sorry












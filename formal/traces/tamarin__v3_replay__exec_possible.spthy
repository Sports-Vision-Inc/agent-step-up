theory ASU_V3_Replay begin

// Function signature and definition of the equational theory E

functions: fst/1, h/1, pair/2, pk/1, sign/2, snd/1, true/0, verify/3
equations:
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true









restriction Equality:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

restriction FirstEnrollmentOnce:
  "∀ U #i #j. ((OnlyOnce( U ) @ #i) ∧ (OnlyOnce( U ) @ #j)) ⇒ (#i = #j)"
  // safety formula

rule (modulo E) Register_Device:
   [ Fr( ~sk ) ]
  --[ OnlyOnce( $U ), Register( $U, pk(~sk) ) ]->
   [ !Ltk( $U, ~sk ), !Pk( $U, pk(~sk) ), Out( pk(~sk) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Compromise_Device:
   [ !Ltk( U, sk ) ] --[ Compromise( U ) ]-> [ Out( sk ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Gateway_ToolCall:
   [ In( <'call', U, e> ), !Pk( U, pkU ), Fr( ~aid ) ]
  --[ Challenge( U, ~aid, e ) ]->
   [ Pending( U, ~aid, e ), ToDevice( U, ~aid, e ), Out( ~aid ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Human_DecidesOnTrustedFields:
   [ ToDevice( U, aid, e ), !Ltk( U, sk ) ]
  --[ HumanApproves( U, aid, e ), Signed( U, aid, h(e) ) ]->
   [ Out( sign(<'ASU-APPROVAL-v2', h(e), aid, 'null'>, sk) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Gateway_Verify:
   [ Pending( U, aid, e ), In( s ), !Pk( U, pkU ) ]
  --[
  Eq( verify(s, <'ASU-APPROVAL-v2', h(e), aid, 'null'>, pkU), true ),
  Approved( U, aid, e )
  ]->
   [ !ApprovedSt( U, aid, e, s ) ]

  /*
  rule (modulo AC) Gateway_Verify:
     [ Pending( U, aid, e ), In( s ), !Pk( U, pkU ) ]
    --[ Eq( z, true ), Approved( U, aid, e ) ]->
     [ !ApprovedSt( U, aid, e, s ) ]
    variants (modulo AC)
    1. aid   = aid.7
       e     = e.7
       pkU   = pkU.7
       s     = s.7
       z     = verify(s.7, <'ASU-APPROVAL-v2', h(e.7), aid.7, 'null'>, pkU.7)
    
    2. aid   = x.7
       e     = x.8
       pkU   = pk(x.9)
       s     = sign(<'ASU-APPROVAL-v2', h(x.8), x.7, 'null'>, x.9)
       z     = true
  */

rule (modulo E) Gateway_Execute:
   [ !ApprovedSt( U, aid, e, s ), In( <'exec', aid, e2> ) ]
  --[ Eq( h(e2), h(e) ), Execute( U, aid, e ) ]->
   [ Out( <'receipt', U, aid, h(e), 'null', s> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Judge_Accept:
   [ In( <'receipt', U, aid, hd, gd, s> ), !Pk( U, pkU ) ]
  --[
  Eq( verify(s, <'ASU-APPROVAL-v2', hd, aid, gd>, pkU), true ),
  JudgeAccepts( U, aid, hd )
  ]->
   [ ]

  /*
  rule (modulo AC) Judge_Accept:
     [ In( <'receipt', U, aid, hd, gd, s> ), !Pk( U, pkU ) ]
    --[ Eq( z, true ), JudgeAccepts( U, aid, hd ) ]->
     [ ]
    variants (modulo AC)
    1. aid   = aid.10
       gd    = gd.11
       hd    = hd.12
       pkU   = pkU.13
       s     = s.14
       z     = verify(s.14, <'ASU-APPROVAL-v2', hd.12, aid.10, gd.11>, pkU.13)
    
    2. aid   = aid.13
       gd    = gd.14
       hd    = hd.15
       pkU   = pk(x.23)
       s     = sign(<'ASU-APPROVAL-v2', hd.15, aid.13, gd.14>, x.23)
       z     = true
  */

lemma exec_possible:
  exists-trace
  "∃ U aid e #i.
    (Execute( U, aid, e ) @ #i) ∧ (¬(∃ #k. Compromise( U ) @ #k))"
/*
guarded formula characterizing all satisfying traces:
"∃ U aid e #i.
  (Execute( U, aid, e ) @ #i) ∧ ∀ #k. (Compromise( U ) @ #k) ⇒ ⊥"
*/
simplify
solve( !ApprovedSt( U, aid, e, s ) ▶₀ #i )
  case Gateway_Verify
  solve( !KU( sign(<'ASU-APPROVAL-v2', h(e), ~aid, 'null'>, ~sk)
         ) @ #vk.6 )
    case Human_DecidesOnTrustedFields
    solve( !KU( ~aid ) @ #vk.4 )
      case Gateway_ToolCall
      SOLVED // trace found
    qed
  qed
qed

lemma judge_possible:
  exists-trace
  "∃ U aid hd #i.
    (JudgeAccepts( U, aid, hd ) @ #i) ∧ (¬(∃ #k. Compromise( U ) @ #k))"
/*
guarded formula characterizing all satisfying traces:
"∃ U aid hd #i.
  (JudgeAccepts( U, aid, hd ) @ #i) ∧ ∀ #k. (Compromise( U ) @ #k) ⇒ ⊥"
*/
by sorry

lemma L1_effect_binding:
  all-traces
  "∀ U aid e #i.
    (Execute( U, aid, e ) @ #i) ⇒
    ((∃ #j. (HumanApproves( U, aid, e ) @ #j) ∧ (#j < #i)) ∨
     (∃ #k. (Compromise( U ) @ #k) ∧ (#k < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ U aid e #i.
  (Execute( U, aid, e ) @ #i)
 ∧
  (∀ #j. (HumanApproves( U, aid, e ) @ #j) ⇒ ¬(#j < #i)) ∧
  (∀ #k. (Compromise( U ) @ #k) ⇒ ¬(#k < #i))"
*/
by sorry

lemma L1_sig_binding:
  all-traces
  "∀ U aid e #i.
    (Execute( U, aid, e ) @ #i) ⇒
    ((∃ #j. (Signed( U, aid, h(e) ) @ #j) ∧ (#j < #i)) ∨
     (∃ #k. (Compromise( U ) @ #k) ∧ (#k < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ U aid e #i.
  (Execute( U, aid, e ) @ #i)
 ∧
  (∀ #j. (Signed( U, aid, h(e) ) @ #j) ⇒ ¬(#j < #i)) ∧
  (∀ #k. (Compromise( U ) @ #k) ⇒ ¬(#k < #i))"
*/
by sorry

lemma L2_single_use:
  all-traces
  "∀ U1 U2 aid e1 e2 #i #j.
    ((Execute( U1, aid, e1 ) @ #i) ∧ (Execute( U2, aid, e2 ) @ #j)) ⇒
    (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ U1 U2 aid e1 e2 #i #j.
  (Execute( U1, aid, e1 ) @ #i) ∧ (Execute( U2, aid, e2 ) @ #j)
 ∧
  ¬(#i = #j)"
*/
by sorry

lemma L3_agent_independence:
  all-traces
  "∀ U aid e #i.
    (Approved( U, aid, e ) @ #i) ⇒
    ((∃ #j. (HumanApproves( U, aid, e ) @ #j) ∧ (#j < #i)) ∨
     (∃ #k. (Compromise( U ) @ #k) ∧ (#k < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ U aid e #i.
  (Approved( U, aid, e ) @ #i)
 ∧
  (∀ #j. (HumanApproves( U, aid, e ) @ #j) ⇒ ¬(#j < #i)) ∧
  (∀ #k. (Compromise( U ) @ #k) ⇒ ¬(#k < #i))"
*/
by sorry

lemma L4_non_repudiation:
  all-traces
  "∀ U aid hd #i.
    (JudgeAccepts( U, aid, hd ) @ #i) ⇒
    ((∃ #j. (Signed( U, aid, hd ) @ #j) ∧ (#j < #i)) ∨
     (∃ #k. (Compromise( U ) @ #k) ∧ (#k < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ U aid hd #i.
  (JudgeAccepts( U, aid, hd ) @ #i)
 ∧
  (∀ #j. (Signed( U, aid, hd ) @ #j) ⇒ ¬(#j < #i)) ∧
  (∀ #k. (Compromise( U ) @ #k) ⇒ ¬(#k < #i))"
*/
by sorry


















theory ASU_V4b_ChatConfirm begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2





restriction FirstEnrollmentOnce:
  "∀ U #i #j. ((OnlyOnce( U ) @ #i) ∧ (OnlyOnce( U ) @ #j)) ⇒ (#i = #j)"
  // safety formula

rule (modulo E) Register_User:
   [ ] --[ OnlyOnce( $U ), Register( $U ) ]-> [ !Enrolled( $U ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Gateway_ToolCall:
   [ In( <'call', U, e> ), !Enrolled( U ), Fr( ~aid ) ]
  --[ Challenge( U, ~aid, e ) ]->
   [ Pending( U, ~aid, e ), ToHuman( U, ~aid, e ), Out( ~aid ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Human_Approves:
   [ ToHuman( U, aid, e ) ]
  --[ HumanApproves( U, aid, e ) ]->
   [ Out( <'yes', aid> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Gateway_Verify:
   [ Pending( U, aid, e ), In( <'yes', aid> ) ]
  --[ Approved( U, aid, e ) ]->
   [ ApprovedSt( U, aid, e ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Gateway_Execute:
   [ ApprovedSt( U, aid, e ), In( <'exec', aid> ) ]
  --[ Execute( U, aid, e ) ]->
   [ ]

  /* has exactly the trivial AC variant */

lemma exec_possible:
  exists-trace "∃ U aid e #i. Execute( U, aid, e ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ U aid e #i. (Execute( U, aid, e ) @ #i)"
*/
simplify
solve( ApprovedSt( U, aid, e ) ▶₀ #i )
  case Gateway_Verify
  solve( !KU( ~aid ) @ #vk.2 )
    case Gateway_ToolCall
    SOLVED // trace found
  qed
qed

lemma L1_effect_binding:
  all-traces
  "∀ U aid e #i.
    (Execute( U, aid, e ) @ #i) ⇒
    (∃ #j. (HumanApproves( U, aid, e ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ U aid e #i.
  (Execute( U, aid, e ) @ #i)
 ∧
  ∀ #j. (HumanApproves( U, aid, e ) @ #j) ⇒ ¬(#j < #i)"
*/
by sorry

lemma L2_single_use:
  all-traces
  "∀ U1 U2 aid e1 e2 #i #j.
    ((Execute( U1, aid, e1 ) @ #i) ∧ (Execute( U2, aid, e2 ) @ #j)) ⇒
    (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ U1 U2 aid e1 e2 #i #j.
  (Execute( U1, aid, e1 ) @ #i) ∧ (Execute( U2, aid, e2 ) @ #j)
 ∧
  ¬(#i = #j)"
*/
by sorry

lemma L3_agent_independence:
  all-traces
  "∀ U aid e #i.
    (Approved( U, aid, e ) @ #i) ⇒
    (∃ #j. (HumanApproves( U, aid, e ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ U aid e #i.
  (Approved( U, aid, e ) @ #i)
 ∧
  ∀ #j. (HumanApproves( U, aid, e ) @ #j) ⇒ ¬(#j < #i)"
*/
by sorry








lemma L5_grant_scope:
  all-traces
  "∀ U gid t r %a #i.
    ((((ExecuteGrant( U, gid, <t, r, %a> ) @ #i) ∧
       (¬(∃ #d. DecidesOnExplanation( U, gid ) @ #d))) ∧
      (¬(∃ #o. EnrollmentOpen( ) @ #o))) ∧
     (¬(∃ #c. CeremonyControl( U ) @ #c))) ⇒
    (((∃ #j.
        ((HumanApproves( U, gid, <t, r, %a> ) @ #j) ∧
         (HumanApprovesGrant( U, gid, <'grant', U, t, r, %a>,
                              h(<'grant', U, t, r, %a>)
          ) @ #j)) ∧
        (#j < #i)) ∨
      (∃ %z #j.
        ((HumanApproves( U, gid, <t, r, (%a%+%z)> ) @ #j) ∧
         (HumanApprovesGrant( U, gid, <'grant', U, t, r, (%a%+%z)>,
                              h(<'grant', U, t, r, (%a%+%z)>)
          ) @ #j)) ∧
        (#j < #i))) ∨
     (∃ #k. (Compromise( U ) @ #k) ∧ (#k < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ U gid t r %a #i.
  (ExecuteGrant( U, gid, <t, r, %a> ) @ #i)
 ∧
  (∀ #d. (DecidesOnExplanation( U, gid ) @ #d) ⇒ ⊥) ∧
  (∀ #o. (EnrollmentOpen( ) @ #o) ⇒ ⊥) ∧
  (∀ #c. (CeremonyControl( U ) @ #c) ⇒ ⊥) ∧
  (∀ #j.
    (HumanApproves( U, gid, <t, r, %a> ) @ #j) ∧
    (HumanApprovesGrant( U, gid, <'grant', U, t, r, %a>,
                         h(<'grant', U, t, r, %a>)
     ) @ #j)
   ⇒
    ¬(#j < #i)) ∧
  (∀ %z #j.
    (HumanApproves( U, gid, <t, r, (%a%+%z)> ) @ #j) ∧
    (HumanApprovesGrant( U, gid, <'grant', U, t, r, (%a%+%z)>,
                         h(<'grant', U, t, r, (%a%+%z)>)
     ) @ #j)
   ⇒
    ¬(#j < #i)) ∧
  (∀ #k. (Compromise( U ) @ #k) ⇒ ¬(#k < #i))"
*/
by sorry

lemma L5b_grant_max_uses:
  all-traces
  "∀ gid k1 k2 k3 #i #j #l.
    (((UseGrant( gid, k1 ) @ #i) ∧ (UseGrant( gid, k2 ) @ #j)) ∧
     (UseGrant( gid, k3 ) @ #l)) ⇒
    (((#i = #j) ∨ (#i = #l)) ∨ (#j = #l))"
/*
guarded formula characterizing all counter-examples:
"∃ gid k1 k2 k3 #i #j #l.
  (UseGrant( gid, k1 ) @ #i) ∧
  (UseGrant( gid, k2 ) @ #j) ∧
  (UseGrant( gid, k3 ) @ #l)
 ∧
  (¬(#i = #j)) ∧ (¬(#i = #l)) ∧ (¬(#j = #l))"
*/
by sorry

lemma X1_L1_effect_binding_noH1:
  all-traces
  "∀ U aid e #i.

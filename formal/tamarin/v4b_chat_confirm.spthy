/*
 * V4b 'chat-confirm' baseline (code: approval_mode "chat-confirm",
 * asu/gateway.py chat_confirm). The approval prompt and the 'yes' both travel
 * on the agent's own channel; the agent can produce the 'yes' itself.
 * Expected: L1_effect_binding and L3_agent_independence FALSIFIED.
 * (Fixes critique F10: Gateway_Verify no longer has an unbound variable.)
 */
theory ASU_V4b_ChatConfirm
begin

restriction FirstEnrollmentOnce:
  "All U #i #j. OnlyOnce(U) @ #i & OnlyOnce(U) @ #j ==> #i = #j"

rule Register_User:
    [ ]
  --[ OnlyOnce($U), Register($U) ]->
    [ !Enrolled($U) ]

rule Gateway_ToolCall:
    [ In(<'call', U, e>), !Enrolled(U), Fr(~aid) ]
  --[ Challenge(U, ~aid, e) ]->
    [ Pending(U, ~aid, e), ToHuman(U, ~aid, e), Out(~aid) ]

/* The human answers 'yes' in the agent's chat. */
rule Human_Approves:
    [ ToHuman(U, aid, e) ]
  --[ HumanApproves(U, aid, e) ]->
    [ Out(<'yes', aid>) ]

/* A 'yes' for aid arriving on the agent channel approves. */
rule Gateway_Verify:
    [ Pending(U, aid, e), In(<'yes', aid>) ]
  --[ Approved(U, aid, e) ]->
    [ ApprovedSt(U, aid, e) ]

rule Gateway_Execute:
    [ ApprovedSt(U, aid, e), In(<'exec', aid>) ]
  --[ Execute(U, aid, e) ]->
    [ ]

lemma exec_possible: exists-trace
  "Ex U aid e #i. Execute(U, aid, e) @ #i"

lemma L1_effect_binding:
  "All U aid e #i. Execute(U, aid, e) @ #i ==>
     (Ex #j. HumanApproves(U, aid, e) @ #j & #j < #i)"

lemma L2_single_use:
  "All U1 U2 aid e1 e2 #i #j.
     Execute(U1, aid, e1) @ #i & Execute(U2, aid, e2) @ #j ==> #i = #j"

lemma L3_agent_independence:
  "All U aid e #i. Approved(U, aid, e) @ #i ==>
     (Ex #j. HumanApproves(U, aid, e) @ #j & #j < #i)"

end

/*
 * V4a 'totp' baseline (code: approval_mode "totp"; asu/gateway.py
 * _check_totp, the in-call totp_code path in _challenge, _execute_unbound;
 * asu/authn/routes.py totp_verify). The out-of-band card shows e, but the
 * approval factor is a TOTP code the human types into the AGENT's chat.
 * A code is h(<k, step>) for the shared seed k; each step is accepted once
 * (store.use_totp_step), modelled by restriction TotpStepOnce.
 * Two code paths, both executing the agent's (re)submitted args:
 *   (a) pending approval + relayed code (Gateway_Verify, Gateway_Execute);
 *   (b) in-call: totp_code in the tool-call body executes immediately with no
 *       pending approval at all (Gateway_ToolCall_WithCode; critique F9).
 * Expected: L1_effect_binding and L3_agent_independence FALSIFIED.
 * No signature, so no receipt / judge.
 */
theory ASU_V4_TOTP_Relay
begin

builtins: hashing

restriction Equality:
  "All x y #i. Eq(x, y) @ #i ==> x = y"

restriction FirstEnrollmentOnce:
  "All U #i #j. OnlyOnce(U) @ #i & OnlyOnce(U) @ #j ==> #i = #j"

restriction TotpStepOnce:
  "All U w #i #j. UseStep(U, w) @ #i & UseStep(U, w) @ #j ==> #i = #j"

/* TOTP seed shared device <-> gateway. */
rule Register_Device:
    [ Fr(~k) ]
  --[ OnlyOnce($U), Register($U) ]->
    [ !TotpKey($U, ~k), !Enrolled($U) ]

rule Compromise_Device:
    [ !TotpKey(U, k) ]
  --[ Compromise(U) ]->
    [ Out(k) ]

rule Gateway_ToolCall:
    [ In(<'call', U, e>), !Enrolled(U), Fr(~aid) ]
  --[ Challenge(U, ~aid, e) ]->
    [ Pending(U, ~aid, e), ToDevice(U, ~aid, e), Out(~aid) ]

/* Human reads the card for aid and types the current code into the agent's
   chat (the agent learns it). ~w is the current time step. */
rule Human_Approves_TypesCode:
    [ ToDevice(U, aid, e), !TotpKey(U, k), Fr(~w) ]
  --[ HumanApproves(U, aid, e) ]->
    [ Out(<~w, h(<k, ~w>)>) ]

/* (a) gateway accepts a valid unused code for ANY pending approval of U. */
rule Gateway_Verify:
    [ Pending(U, aid, e), In(<'code', aid, w, code>), !TotpKey(U, k) ]
  --[ Eq(code, h(<k, w>)), UseStep(U, w), Approved(U, aid, e) ]->
    [ ApprovedSt(U, aid, e) ]

rule Gateway_Execute:
    [ ApprovedSt(U, aid, e), In(<'exec', aid, e2>) ]
  --[ Execute(U, aid, e2) ]->
    [ ]

/* (b) in-call path: the code rides along with the tool call. */
rule Gateway_ToolCall_WithCode:
    [ In(<'call_totp', U, e, w, code>), !TotpKey(U, k), Fr(~aid) ]
  --[ Eq(code, h(<k, w>)), UseStep(U, w), Approved(U, ~aid, e), Execute(U, ~aid, e) ]->
    [ ]

lemma exec_possible: exists-trace
  "Ex U aid e #i. Execute(U, aid, e) @ #i & not (Ex #k. Compromise(U) @ #k)"

lemma L1_effect_binding:
  "All U aid e #i. Execute(U, aid, e) @ #i ==>
     (Ex #j. HumanApproves(U, aid, e) @ #j & #j < #i)
   | (Ex #k. Compromise(U) @ #k & #k < #i)"

lemma L2_single_use:
  "All U1 U2 aid e1 e2 #i #j.
     Execute(U1, aid, e1) @ #i & Execute(U2, aid, e2) @ #j ==> #i = #j"

lemma L3_agent_independence:
  "All U aid e #i. Approved(U, aid, e) @ #i ==>
     (Ex #j. HumanApproves(U, aid, e) @ #j & #j < #i)
   | (Ex #k. Compromise(U) @ #k & #k < #i)"

end
